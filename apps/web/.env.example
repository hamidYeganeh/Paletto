# Real deployment uses a replica set (MongoDB Atlas or self-hosted).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=paletto
APP_ORIGIN=http://localhost:3000
# Required for image uploads on a deployment: persistent shared volume.
PALETTO_MEDIA_ROOT=/absolute/path/to/paletto-media
# Optional until payment onboarding is complete. Never prefix with NEXT_PUBLIC_.
ZARINPAL_MERCHANT_ID=
# Local preview only. Omit MONGODB_URI to use the development file store.
PALETTO_DEMO=false
PALETTO_ALLOW_LOCAL_STORE=false
PALETTO_DISABLE_BUILD_CACHE=false
