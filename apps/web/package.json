{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/platform.test.ts",
    "test:e2e": "playwright test",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "dev:demo": "PALETTO_DEMO=true next dev --webpack",
    "test:serve": "tsx scripts/seed-browser.ts && next dev --webpack --hostname 127.0.0.1 --port 3100"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "@workspace/ui": "*",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.27.0",
    "mongodb": "^7.6.0",
    "motion": "^12.43.0",
    "next": "16.3.4",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-use-measure": "^2.1.7",
    "three": "^0.185.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
