# Copy to .env.local and fill in values.

# MongoDB replica set is required for transactional order flows.
MONGODB_URI=mongodb://127.0.0.1:27017/paletto?replicaSet=rs0
MONGODB_DB=paletto

# Public origin of the web app (CORS allow-list, payment callback base).
APP_ORIGIN=http://localhost:3000

# API runtime
PORT=4000
NODE_ENV=development

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional until payment onboarding is complete.
ZARINPAL_MERCHANT_ID=

# Admin bootstrap (scripts/bootstrap-admin.ts). Remove from env after running.
PALETTO_ADMIN_EMAIL=
PALETTO_ADMIN_PASSWORD=
